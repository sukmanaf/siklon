# ============================================================
# SIKLON — contoh environment. Salin jadi .env lalu sesuaikan.
# ============================================================

# --- Database (PostgreSQL lokal, BUKAN Docker) ---
DATABASE_URL="postgresql://postgres:123123@localhost:5432/absen"

# --- API ---
PORT=4000
NODE_ENV=development
TZ=Asia/Jakarta

# --- Autentikasi ---
# Buat nilai acak: openssl rand -base64 48
JWT_SECRET="dev-only-secret-minimal-32-karakter-jangan-dipakai-produksi"
JWT_EXPIRES_IN="12h"

# --- Scanner Agent ---
# Dipakai agent pada header X-Api-Key. Buat acak: openssl rand -hex 24
SCANNER_API_KEY="dev-scanner-key-1234567890"

# --- WhatsApp ---
# dummy  = hanya dicatat di log, TIDAK mengirim apa pun (default, aman)
# baileys = mengirim sungguhan lewat nomor yang men-scan QR
#
# Ini PENGAMAN KERAS: nilai dummy di sini mengalahkan setelan apa pun di
# database. Jadi salah setel di halaman Pengaturan tidak bisa membuat server
# development tiba-tiba mengirim pesan ke wali murid sungguhan.
WA_PROVIDER=dummy
WA_SESSION_PATH="./storage/wa-session"

# Daftar nomor yang BOLEH menerima pesan, dipisah koma (format 62...).
# Saat NODE_ENV bukan production dan provider = baileys:
#   - daftar terisi -> hanya nomor ini yang dikirimi, sisanya dilewati & dicatat
#   - daftar kosong -> pengiriman DITOLAK dengan peringatan keras
# Tujuannya satu: mustahil membanjiri 600 wali murid karena salah klik saat uji coba.
WA_ALLOWLIST=

# --- Penyimpanan berkas (di luar webroot) ---
STORAGE_PATH="./storage"

# --- Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
